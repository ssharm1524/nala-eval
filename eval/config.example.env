# Settings for one replay study. Copy this file to eval/config.env and fill it in.
# The shell tools source it; the Python tools read it through nala_config.py.
# Keep config.env out of a public copy: it names your private source project.

# Local clone of the source project that the replayed tickets come from.
NALA_SOURCE_REPO=~/src/your-project
# GitHub OWNER/NAME of the source project. The tickets are copied from its issues.
NALA_SOURCE_NAME=your-org/your-project
# GitHub OWNER/NAME of your private copy of this harness, which holds the hidden tests.
# The eval sign-in must not reach it, and the audit flags any call that names it.
NALA_HARNESS_NAME=your-org/your-eval-private

# Every run starts from this source commit, when all the replayed tickets were open.
NALA_START_COMMIT=
# Optional: a later source commit whose change is applied to the start commit as a patch,
# for example the real fix of a ticket outside the batch that a batch ticket depends on.
NALA_PRESTART_FIX=
# Source ticket numbers in batch order. A fresh scratch repository numbers them 1, 2, 3, ...
NALA_TICKETS="101 102 103"

# Folder the scratch repositories are built in.
NALA_SCRATCH_ROOT=~/nala-eval-runs
# GitHub command line folder that holds the eval token (see eval/README.md).
NALA_EVAL_GH_CONFIG=~/.config/gh-nala-eval

# More folders an attempt must not read, separated by ":". Name every folder that holds
# the real fixes, the hidden tests, or notes written while making them.
NALA_CLOSED_FOLDERS=
# Sign-in folders of outside services, separated by ":". An attempt must not read them.
NALA_SERVICE_FOLDERS=~/.railway:~/.supabase:~/.expo:~/.vercel:~/.config/gcloud
# Command line tools of outside services. Every session is denied them.
NALA_DENIED_COMMANDS="railway supabase vercel eas gcloud wrangler"
# A network address that contains one of these is removed from the sandbox allow list.
NALA_SERVICE_DOMAIN_MARKS="railway supabase api.cloudflare.com google"
# More folders a session may write, separated by ":", for tools the merge check runs.
NALA_EXTRA_WRITABLE=~/.local/state/watchman:~/.local/share/uv

# The orchestrator under test marks its own comments "<prefix>:blocker:", "<prefix>:claim", ...
NALA_ORCH_MARK_PREFIX=orchestrator
# Labels the orchestrator puts on tickets itself, created in each scratch repository.
NALA_EXTRA_LABELS="in-progress"
# Optional: a script run once on the built scratch repository, before its first commit,
# for adjustments specific to your source project. It gets the repository path as $1 and
# prints one line per adjustment, which the setup record lists.
NALA_SETUP_HOOK=
# The transcript audit also flags any tool call that contains one of these.
NALA_AUDIT_MARKS="railway supabase.co vercel"
# The v1.8 swarm version's start script, relative to the scratch repository.
NALA_SWARM_START=scripts/lead_start.sh
